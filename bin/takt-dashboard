  .group .node { min-width:170px; }
  svg.edges { position:absolute; left:0; top:0; pointer-events:none; overflow:visible; }
  svg.edges path { fill:none; stroke:var(--dim); stroke-width:1.2; }
  svg.edges path.e-done { stroke:rgba(115,205,162,.7); }
</style></head>
