#!/usr/bin/env node
// takt-dashboard — TAKT (https://github.com/nrslib/takt) の run を見張るローカル Web ダッシュボード
//   takt-dashboard                       最新 run を http://localhost:7331 で表示（実行中を優先）
//   takt-dashboard <run_dir>             run ディレクトリ固定
//   takt-dashboard --port N              ポート変更
//   takt-dashboard --roots ~/git,~/work  run を探すディレクトリ（その直下のリポジトリ / worktree も見る）。環境変数 TAKT_DASHBOARD_ROOTS でも可
// データ元は run ディレクトリの logs/*.jsonl・meta.json・reports/。provider/model が無い並列サブステップは
// ~/.takt/runtime.yaml（無ければ config.yaml）から引く。
import { createServer } from 'node:http';
import { readFileSync, readdirSync, existsSync, statSync, realpathSync, mkdirSync, writeFileSync, writeSync, renameSync } from 'node:fs';
import path from 'node:path';
import os from 'node:os';
import { fileURLToPath } from 'node:url';

const HOME = os.homedir();
const args = process.argv.slice(2);
// ---------- 設定 ----------
// ダッシュボード自身のデータは ~/.config/takt-dashboard/ に置く（takt 本体の ~/.takt/ とは分ける）:
//   config.yaml        roots / port（任意）
//   routing/<run>.json run ごとの provider 割り当ての控え（自動生成）
//   takt-logo.svg      ヘッダーのロゴを差し替えたいとき（任意。通常は takt 本体同梱のロゴを使う）
const CFG_DIR = path.join(HOME, '.config', 'takt-dashboard');
const expandHome = (p) => path.resolve(p.replace(/^~(?=\/|$)/, HOME));
// 表示用に HOME を ~ に縮める。文字列の前方一致ではなく path.relative で判定する（HOME と先頭だけ同じ別ディレクトリ（/Users/foo に対する /Users/foobar）を縮めないため、
// また os.homedir() は環境変数 HOME をそのまま返すので、末尾に / が付いた HOME や / の HOME でも HOME 配下を縮めるため）
const tildify = (p) => {
  const rel = path.relative(HOME, p);
  if (!rel) return '~';
  return rel === '..' || rel.startsWith('..' + path.sep) || path.isAbsolute(rel) ? p : path.join('~', rel);
};
// config.yaml は roots（リスト or , 区切り）と port だけの簡単な形式。yaml ライブラリ無しで読む
// yaml の行末コメントを外す（config.yaml / runtime.yaml / workflow yaml の自前パースで共通）。
// YAML の # は行頭か空白の後にあるものだけがコメントで、引用符の中の #（例: "review#critical"）や空白を挟まない #（例: a#b）は値の一部。
// 引用符は値の先頭（行頭、「- 」の後、「キー: 」の後、[ { , の後）にあるものだけが引用の開始。平文の値の途中の引用符（例: /tmp/repo '23）は値の一部
function stripYamlComment(l) {
  let q = null;
  for (let i = 0; i < l.length; i++) {
    const c = l[i];
    if (q) {
      if (q === '"' && c === '\\') i++; // "…\"…" のエスケープ
      else if (q === "'" && c === "'" && l[i + 1] === "'") i++; // '…''…' は ' のエスケープ
      else if (c === q) q = null;
    } else if ((c === '"' || c === "'") && /(^\s*|(^|\s)-\s+|:\s+|[[{,]\s*)$/.test(l.slice(0, i))) q = c;
    else if (c === '#' && (i === 0 || /\s/.test(l[i - 1]))) return l.slice(0, i);
  }
  return l;
}
// roots の区切りは , だけ（--roots / TAKT_DASHBOARD_ROOTS / config.yaml の roots: a, b で共通）。
// : でも区切ると、Windows のドライブ指定（C:\work）や : を含むディレクトリ名が 2 つに分かれてしまう
const splitRoots = (spec) => spec.split(',').map((s) => s.trim()).filter(Boolean);
function loadConfig() {
  const cfg = { roots: [], port: null };
  let text; try { text = readFileSync(path.join(CFG_DIR, 'config.yaml'), 'utf8'); } catch { return cfg; }
  let inRoots = false;
  for (const raw of text.split('\n')) {
    const line = stripYamlComment(raw).trimEnd();
    if (!line.trim()) continue;
    let m;
    if ((m = line.match(/^port:\s*(\d+)/))) { cfg.port = Number(m[1]); inRoots = false; continue; }
    if ((m = line.match(/^roots:\s*(.*)$/))) { inRoots = true; cfg.roots.push(...splitRoots(m[1])); continue; }
    if (inRoots && (m = line.match(/^\s+-\s*(.+)$/))) { cfg.roots.push(m[1].trim().replace(/^['"]|['"]$/g, '')); continue; }
    inRoots = false;
  }
  return cfg;
}
const CONFIG = loadConfig();
const optVal = (name) => { const i = args.indexOf(name); return i >= 0 ? args[i + 1] : undefined; };
// 優先順: コマンドライン > 環境変数 > config.yaml > 既定
const PORT = Number(optVal('--port') ?? process.env.TAKT_DASHBOARD_PORT ?? CONFIG.port ?? 7331);
const FIXED_RUN = args.find((a, i) => !a.startsWith('--') && !(i > 0 && args[i - 1].startsWith('--'))) ?? null;
// runRecord が返す <run_dir> の runDir。UI は表示中の run を ?run= にこの値で送り返すので、currentRun はこれと字面で照合する
const FIXED_RUN_DIR = FIXED_RUN ? path.resolve(FIXED_RUN) : null;
// run を探すディレクトリ。カレントディレクトリと ~/.takt に加えて、--roots / TAKT_DASHBOARD_ROOTS（, 区切り）/ config.yaml の roots と、その直下のディレクトリ
const rootsSpec = optVal('--roots') ?? process.env.TAKT_DASHBOARD_ROOTS;
const EXTRA_ROOTS = (rootsSpec !== undefined ? splitRoots(rootsSpec) : CONFIG.roots.map((s) => s.trim()).filter(Boolean)).map(expandHome);

// ---------- run 探索 ----------
function listDirs(p) {
  let names; try { names = readdirSync(p); } catch { return []; }
  // stat は項目ごとに失敗を飛ばす。takt list で消した worktree へのリンクや、走査中に消えた項目が 1 つあるだけで、同じディレクトリの run が全部消えないように
  return names.map((d) => path.join(p, d)).filter((d) => { try { return statSync(d).isDirectory(); } catch { return false; } });
}
// Web UI（takt ui）から起動した run は <repo>/.takt/runs ではなく ~/.takt/state/projects/<id>/runs に書かれる
const UI_PROJECTS_DIR = path.join(HOME, '.takt', 'state', 'projects');
// run ディレクトリ（meta.json のある場所）から run の記録を作る。一覧（findRuns）・?run= で一覧に無い run（zip で持ってきたもの等）・<run_dir> のどれもここを通し、
// root と中断判定を揃える。meta.json が読めなければ throw する（呼び出し側で、一覧なら飛ばす・?run= なら見つからない扱い・起動時なら終了）
function runRecord(dir, taskCache) {
  const runDir = path.resolve(dir);
  const meta = JSON.parse(readFileSync(path.join(runDir, 'meta.json'), 'utf8'));
  const runsDir = path.dirname(runDir), projDir = path.dirname(runsDir);
  if (path.basename(runsDir) === 'runs' && path.dirname(projDir) === UI_PROJECTS_DIR) {
    // Web UI の run: root は state.json の canonicalDirectory（本体リポジトリ）にして、tasks.yaml の逆引きや repo 名の表示を CLI の run と揃える。
    // tasks.yaml にはエントリが無いので、一覧のラベルは meta.task の先頭行（見出し）から取る。
    let root = projDir;
    try { root = JSON.parse(readFileSync(path.join(projDir, 'state.json'), 'utf8')).canonicalDirectory || projDir; } catch {}
    const label = String(meta.task ?? '').split('\n').find((l) => l.trim())?.replace(/^#+\s*/, '') ?? null;
    return { meta, root, runDir, label: label ? 'UI: ' + label : 'UI' };
  }
  const root = path.resolve(runDir, '..', '..', '..'); // <root>/.takt/runs/<run>
  if (meta.status === 'running' && isRunInterrupted(root, meta, taskCache)) meta.status = 'interrupted';
  return { meta, root, runDir };
}
// 先頭が区切り文字 2 つのパス（\\host\share・//host/share・\\?\UNC\…・\\.\pipe\…）。Windows ではネットワーク上の場所やデバイスを指す
const isNetworkPath = (p) => /^[\\/]{2}/.test(p);
// リポジトリの候補: カレントディレクトリと、EXTRA_ROOTS とその直下のディレクトリ。run の探索（findRuns）と tasks.yaml の逆引き（tasksYamlFor）で使う。
// ~/.takt は findRuns だけが足す（逆引きの候補には入れない）。揃えると run 一覧や逆引きの結果（repo 名・キュー・中断判定）が変わりうるので、この違いはそのまま残している
function repoCandidates() {
  return [process.cwd(), ...EXTRA_ROOTS.flatMap((r) => [r, ...listDirs(r)])];
}
// リポジトリの .takt/clone-meta/*.json に書かれた clonePath（takt が作った worktree の場所）の一覧。読めないファイルは飛ばす
function cloneMetaPaths(repo) {
  const metaDir = path.join(repo, '.takt', 'clone-meta');
  const paths = [];
  for (const f of (existsSync(metaDir) ? readdirSync(metaDir) : [])) {
    try { const cp = JSON.parse(readFileSync(path.join(metaDir, f), 'utf8')).clonePath; if (cp) paths.push(cp); } catch {}
  }
  return paths;
}
// リポジトリから辿れる worktree の一覧: clone-meta の clonePath と、.takt/tasks.yaml の worktree_path。
// worktree_path は parseTasks で読む（空白を含むパスや引用符付きの値を、currentTask の照合と同じ値として扱うため）。
// 一覧（findRuns）と逆引き（tasksYamlFor）の両方がここを通る。読めない tasks.yaml は飛ばす
function worktreePathsOf(repo) {
  let tasks = [];
  try { tasks = parseTasks(readFileSync(path.join(repo, '.takt', 'tasks.yaml'), 'utf8')); } catch {}
  return [...cloneMetaPaths(repo), ...tasks.map((t) => t.worktree_path).filter(Boolean)];
}
function findRuns(taskCache) {
  // 探索の順番は cwd → ~/.takt → EXTRA_ROOTS（とその直下）。~/.takt を含むのは findRuns だけ（repoCandidates のコメントを参照）
  const roots = new Set([process.cwd(), path.join(HOME, '.takt'), ...repoCandidates()]);
  // リポジトリから takt が作った worktree を辿る: .takt/clone-meta/*.json の clonePath と tasks.yaml の worktree_path。
  // takt の既定では worktree はリポジトリの隣（../<clone-name>）に作られるので、リポジトリで起動すれば --roots 無しで見つかる
  for (const repo of [...roots]) for (const wt of worktreePathsOf(repo)) if (existsSync(wt)) roots.add(wt);
  const runDirs = [...roots].flatMap((root) => listDirs(path.join(root, '.takt', 'runs')));
  for (const projDir of listDirs(UI_PROJECTS_DIR)) runDirs.push(...listDirs(path.join(projDir, 'runs')));
  const runs = [];
  for (const runDir of runDirs) {
    if (!existsSync(path.join(runDir, 'meta.json'))) continue;
    try { runs.push(runRecord(runDir, taskCache)); } catch {}
  }
  return runs.sort((a, b) => {
    const ra = a.meta.status === 'running' ? 1 : 0, rb = b.meta.status === 'running' ? 1 : 0;
    if (ra !== rb) return rb - ra;
    return String(b.meta.updatedAt ?? '').localeCompare(String(a.meta.updatedAt ?? ''));
  });
}

// ---------- 中断判定 ----------
// takt はプロセスが落ちると tasks.yaml / meta.json の status が running のまま残る（アプリ再起動などで kill された場合）。
// tasks.yaml の owner_pid の生存を確認し、死んでいれば 'interrupted'（表示は「中断」）に読み替える。
function isPidAlive(pid) {
  if (!pid) return false;
  try { process.kill(pid, 0); return true; } catch (e) { return e.code === 'EPERM'; }
}
// parseTasks が返したタスク（tasks.yaml の生の値）の status。running で owner_pid が死んでいれば 'interrupted'
function taskStatus(t) {
  return t.status === 'running' && !isPidAlive(Number(t.owner_pid)) ? 'interrupted' : t.status;
}
// run の meta.json が running のとき、対応するタスク（worktree_path が一致）が実行中でなければ中断扱い。
// タスクが見つからない run（worktree 外の直接実行など）は判定できないので running のままにする。
function isRunInterrupted(root, meta, cache) {
  const t = taskForRoot(root, cache);
  if (!t) return false;
  if (taskStatus(t) !== 'running') return true;
  return Boolean(t.run_slug) && t.run_slug !== meta.runSlug; // 同じ worktree で再実行中の場合、古い run は中断
}

// ---------- routing ----------
// yaml の小さな部分集合を読む: ブロック形式の map / list と、1 行に収まるフロー形式（{ a: b } / [a, b]）・引用符付きの値。
// runtime.yaml は takt が yaml ライブラリの stringify で書くとブロック形式（profiles の下が複数行）になり、手書きではフロー形式もあるので両方読む。
// 複数行にまたがるフロー形式や複数行の文字列は対象外（runtime.yaml の provider 配下では使わない）
function parseYamlScalar(v) {
  v = v.trim();
  if (/^\{.*\}$/.test(v) || /^\[.*\]$/.test(v)) {
    const isMap = v[0] === '{'; const body = v.slice(1, -1);
    const parts = []; let depth = 0, q = null, cur = '';
    for (const c of body) {
      if (q) { if (c === q) q = null; }
      else if (c === '"' || c === "'") q = c;
      else if (c === '{' || c === '[') depth++;
      else if (c === '}' || c === ']') depth--;
      else if (c === ',' && depth === 0) { parts.push(cur); cur = ''; continue; }
      cur += c;
    }
    if (cur.trim()) parts.push(cur);
    if (!isMap) return parts.map(parseYamlScalar);
    const out = {};
    for (const p of parts) { const m = p.match(/^\s*([^:]+?)\s*:\s*(.*)$/); if (m) out[parseYamlScalar(m[1])] = m[2].trim() === '' ? null : parseYamlScalar(m[2]); }
    return out;
  }
  if (/^".*"$/.test(v)) { try { return JSON.parse(v); } catch { return v.slice(1, -1); } }
  if (/^'.*'$/.test(v)) return v.slice(1, -1).replace(/''/g, "'");
  return v;
}
function parseYamlBlock(text) {
  const lines = text.split('\n').map(stripYamlComment).filter((l) => l.trim()).map((l) => ({ indent: l.match(/^ */)[0].length, body: l.trim() }));
  let i = 0;
  // indent の深さにある map か list を読む。読み終えたら i は次の兄弟（より浅い行）を指す
  const node = (indent) => {
    if (lines[i]?.body.startsWith('- ') || lines[i]?.body === '-') {
      const list = [];
      while (i < lines.length && lines[i].indent === indent && (lines[i].body.startsWith('- ') || lines[i].body === '-')) {
        const rest = lines[i].body.slice(1).trim();
        if (/^[^{["'][^:]*:(\s|$)/.test(rest)) { lines[i] = { indent: indent + 2, body: rest }; list.push(node(indent + 2)); } // - key: v は map の要素
        else { i++; list.push(rest === '' && lines[i]?.indent > indent ? node(lines[i].indent) : parseYamlScalar(rest)); }
        while (i < lines.length && lines[i].indent > indent) i++;
      }
      return list;
    }
    const map = {};
    while (i < lines.length && lines[i].indent === indent) {
      const m = lines[i].body.match(/^("[^"]*"|'[^']*'|[^:]+?)\s*:(?:\s+(.*))?$/);
      i++;
      if (!m) continue;
      const key = parseYamlScalar(m[1]);
      if (m[2] !== undefined && m[2] !== '') map[key] = parseYamlScalar(m[2]);
      else map[key] = (i < lines.length && lines[i].indent > indent) ? node(lines[i].indent) : null;
      while (i < lines.length && lines[i].indent > indent) i++; // 読めなかった深い行（複数行のフロー形式など）は飛ばし、兄弟のキーを読み続ける
    }
    return map;
  };
  try { return lines.length ? node(lines[0].indent) : {}; } catch { return {}; }
}
// 設定からは決まらない割り当て（表示は「?」）。ログ（usage_events）があればそちらの実際の値で上書きする
const PM_UNKNOWN = { provider: null, model: null };
// runtime.yaml（provider.profiles + targets.steps/tags 形式）を優先し、
// 無ければ旧 config.yaml の provider_routing.steps を読む。表示上はどちらも「設定値」。
// takt 0.74.0 の dist/infra/config/runtime-provider/（schema.js・policy.js・loader.js）で確認した形式に合わせる:
// - profile の extends は親の provider / model を子の値で上書きする（policy.js の flattenProfiles）
// - 割り当ては profile（固定）・ladder（昇格で次の profile に進む）・pool（実行時に router が選ぶ）のどれか。
//   ladder と pool は実行中にどれを使ったかが設定から決まらないので PM_UNKNOWN にする
// - assignments（名前付きの割り当て）は defaults.assignment か実行時の指定で選ばれ、どれが使われたか分からないので全体を PM_UNKNOWN にする
// - targets.personas は step の persona で引くが、step の persona を読んでいないので、steps / tags に無い step は PM_UNKNOWN にする
function loadRuntimeRouting(p = path.join(HOME, '.takt', 'runtime.yaml')) {
  if (!existsSync(p)) return null;
  const text = readFileSync(p, 'utf8');
  if (!/^provider:/m.test(text)) return null;
  const pv = parseYamlBlock(text).provider;
  const base = { source: path.basename(p), mtime: statSync(p).mtimeMs };
  if (!pv || typeof pv !== 'object' || Array.isArray(pv)) return { steps: {}, tags: {}, def: { provider: 'claude', model: null }, ...base };
  const isMap = (o) => o && typeof o === 'object' && !Array.isArray(o);
  if (isMap(pv.assignments) && Object.keys(pv.assignments).length) return { steps: {}, tags: {}, def: PM_UNKNOWN, ...base };
  const profiles = isMap(pv.profiles) ? pv.profiles : {};
  const flat = {};
  const profileOf = (name, seen = new Set()) => {
    if (flat[name]) return flat[name];
    const pr = profiles[name];
    if (!isMap(pr) || seen.has(name)) return null; // 未定義・循環（takt は起動時に弾くので通常は来ない）
    seen.add(name);
    const parent = pr.extends ? profileOf(pr.extends, seen) : {};
    if (!parent) return null;
    const out = { provider: pr.provider ?? parent.provider ?? null, model: pr.model ?? parent.model ?? null };
    return (flat[name] = out);
  };
  // 割り当て 1 つ（{ profile } / { ladder } / { pool }）→ { provider, model }。無ければ null
  const assign = (a) => {
    if (!isMap(a)) return null;
    if (a.profile !== undefined) { const r = profileOf(a.profile); return r?.provider ? { provider: r.provider, model: r.model } : PM_UNKNOWN; }
    return (a.ladder !== undefined || a.pool !== undefined || a.assignment !== undefined) ? PM_UNKNOWN : null;
  };
  const targets = isMap(pv.targets) ? pv.targets : {};
  const pick = (m) => { const out = {}; if (isMap(m)) for (const [k, v] of Object.entries(m)) { const r = assign(v); if (r) out[k] = r; } return out; };
  const steps = pick(targets.steps), tags = pick(targets.tags);
  const hasPersonas = isMap(targets.personas) && Object.keys(targets.personas).length > 0;
  return { steps, tags, def: assign(pv.defaults) ?? { provider: 'claude', model: null }, ...(hasPersonas ? { hasPersonas } : {}), ...base };
}
function loadRouting(cfg = path.join(HOME, '.takt', 'config.yaml')) {
  const rt = loadRuntimeRouting();
  if (rt) return rt;
  return loadConfigRouting(cfg);
}
function loadConfigRouting(cfg) {
  const steps = {}; const def = { provider: 'claude', model: null };
  if (!existsSync(cfg)) return { steps, tags: {}, def, source: 'config', mtime: 0 };
  let inSteps = false;
  for (const raw of readFileSync(cfg, 'utf8').split('\n')) {
    if (/^\s*#/.test(raw) || !raw.trim()) continue;
    const top = raw.match(/^(provider|model):\s*([\w.-]+)/);
    if (top) def[top[1]] = top[2];
    if (/^\s+steps:/.test(raw)) { inSteps = true; continue; }
    if (inSteps && /^\S/.test(raw)) inSteps = false;
    if (inSteps) {
      const m = raw.match(/^\s+([\w-]+):\s*\{\s*provider:\s*([\w-]+)(?:\s*,\s*model:\s*([\w.-]+))?\s*\}/);
      if (m) steps[m[1]] = { provider: m[2], model: m[3] ?? null };
    }
  }
  return { steps, tags: {}, def, source: path.basename(cfg), mtime: statSync(cfg).mtimeMs };
}

// ---------- run 開始時点の設定 ----------
// yaml を後から変えると過去の run の表示まで変わるのを防ぐ。
// (1) ~/.config/takt-dashboard/routing/<run slug>.json に保存済みならそれを使う（以後 yaml を変えても変わらない）
// (2) 無ければ、~/.takt の runtime.yaml.bak-* / config.yaml.bak.* から run 開始時点で有効だったものを選ぶ。
//     バックアップの mtime は「その内容が置き換えられた時刻」なので、mtime が run 開始より後のもののうち最も早いものが当時の設定。
//     該当が無ければ現在の yaml。選んだ結果を (1) に保存する
const SNAP_DIR = path.join(CFG_DIR, 'routing');
function routingHistory() {
  const dir = path.join(HOME, '.takt');
  const list = (prefix, parse) => {
    let names = []; try { names = readdirSync(dir).filter((n) => n.startsWith(prefix)); } catch {}
    return names.map((n) => ({ file: path.join(dir, n), until: statSync(path.join(dir, n)).mtimeMs, parse }));
  };
  // runtime.yaml は config.yaml から移行されたもの。移行（= config.yaml が最後に置き換えられた時刻）より前の run は config 系のバックアップを見る
  const rt = list('runtime.yaml.bak', loadRuntimeRouting), cf = list('config.yaml.bak', loadConfigRouting);
  // config.yaml が最後に置き換えられた時刻（= runtime.yaml への移行時）。それより前に始まった run は config 系のバックアップを見る
  const runtimeSince = Math.max(...cf.map((x) => x.until), 0);
  return { rt, cf, runtimeSince };
}
const snapPath = (runDir) => path.join(SNAP_DIR, path.basename(runDir) + '.json');
// 控えの書き込みはここだけで行う（routingFor の初回保存と stepTagsFor の書き足しで形式を揃える）。書けなくても表示は続ける。
// 一時ファイルに書いてから rename で置き換える。書き込みの途中で落ちて控えが壊れると、次回は run 開始時の設定を復元できず現在の設定に置き換わってしまうため
function saveRouting(runDir, routing) {
  const target = snapPath(runDir), tmp = target + '.' + process.pid + '.tmp';
  try { mkdirSync(SNAP_DIR, { recursive: true }); writeFileSync(tmp, JSON.stringify(routing, null, 1)); renameSync(tmp, target); } catch {}
}
function routingFor(runDir, startTime) {
  const snap = snapPath(runDir);
  try { if (existsSync(snap)) return JSON.parse(readFileSync(snap, 'utf8')); } catch {}
  const start = startTime ? new Date(startTime).getTime() : 0;
  let routing = null;
  if (start) {
    const h = routingHistory();
    const pool = (start < h.runtimeSince && h.cf.length) ? h.cf : h.rt;
    const cand = pool.filter((x) => x.until > start).sort((a, b) => a.until - b.until)[0];
    if (cand) { routing = cand.parse(cand.file); if (routing) routing.source = path.basename(cand.file); }
  }
  if (!routing) routing = loadRouting();
  routing.savedAt = new Date().toISOString();
  saveRouting(runDir, routing);
  return routing;
}
// 並列の子の tag（workflow yaml の step の tags:）も run 開始時点のものを使う。yaml を後から変えても過去の表示が変わらないよう、
// ワークフローごとに初めて読んだ step の tags を控えの stepTags に書き足し、以後はそれを使う。
// yaml が見つからないときは保存せず null（呼び出し側で既定を使う）
function stepTagsFor(runDir, routing, workflow, root) {
  if (!workflow) return null;
  const saved = routing.stepTags?.[workflow];
  if (saved) return saved;
  const text = workflowYamls(workflow, root)[0]; // takt が使うのは最初に見つかったファイル
  if (text === undefined) return null;
  const tags = stepTagsIn(text);
  routing.stepTags = { ...routing.stepTags, [workflow]: tags };
  saveRouting(runDir, routing);
  return tags;
}

// ---------- タイムライン ----------
function readEvents(runDir) {
  const logsDir = path.join(runDir, 'logs');
  const events = [];
  let files;
  // logs/ には実行のイベント以外の jsonl（usage_events の *-usage-events.jsonl など、type の無い記録）も書かれるので、
  // type が文字列の記録だけをイベントとして扱う（type の無い記録を混ぜるとタイムラインの組み立てで例外になる）
  try { files = readdirSync(logsDir).filter((f) => f.endsWith('.jsonl')).sort(); } catch { return events; }
  for (const f of files) {
    for (const line of readFileSync(path.join(logsDir, f), 'utf8').split('\n')) {
      if (!line.trim()) continue;
      try { const e = JSON.parse(line); if (typeof e?.type === 'string') events.push(e); } catch {}
    }
  }
  return events;
}
// takt の usage_events のログ（logs/*-usage-events.jsonl）を時刻順に返す。provider_model の '(default)' は model 未指定（provider の既定）
function readUsageEvents(runDir) {
  const logsDir = path.join(runDir, 'logs');
  const out = [];
  let files;
  try { files = readdirSync(logsDir).filter((f) => f.endsWith('-usage-events.jsonl')); } catch { return out; }
  for (const f of files) {
    let text;
    try { text = readFileSync(path.join(logsDir, f), 'utf8'); } catch { continue; }
    for (const line of text.split('\n')) {
      let e; try { e = JSON.parse(line); } catch { continue; }
      const at = Date.parse(e?.timestamp);
      if (typeof e?.step !== 'string' || typeof e.provider !== 'string' || !e.provider || Number.isNaN(at)) continue;
      const model = typeof e.provider_model === 'string' && e.provider_model && e.provider_model !== '(default)' ? e.provider_model : null;
      out.push({ step: e.step, provider: e.provider, model, at });
    }
  }
  return out.sort((a, b) => a.at - b.at);
}
// stepTagsOf はワークフロー名から { step 名: [tag, …] }（yaml が無ければ null）を返す関数
function timeline(runDir, routing, meta, stepTagsOf) {
  const events = readEvents(runDir);
  const started = new Set();
  const rows = [];
  const windows = {}; // step#iter → { start, end }（execute〜judge の時間帯）
  const reportPhases = {}; // step#iter → [{ start, end }]（report フェーズごと）
  let lastOutput = null;
  // 並列の子の provider / model は takt 本体と同じ順で引く: targets.steps → targets.tags → defaults。
  // takt 0.74.0 の dist/core/workflow/provider-resolution.js で確認: 優先度の表で provider_routing.steps（3）が tags（4）より先。
  // step の tag が targets.tags に複数あるときは step の tags の並びで後のものが上書きする（resolveTagProviderRoutingEntry）。
  // ただし runtime.yaml の形式では tagConflictPolicy が fail-fast（dist/infra/config/runtime-provider/environment.js）で、
  // 割り当てが食い違う tag がある run はそもそも始まらないので、どれを選んでも同じ profile になる
  const cfgPm = (step, workflow) => {
    const tags = routing.tags ?? {}; // tags の無い古い控えもある
    let s = routing.steps[step];
    if (!s && Object.keys(tags).length) s = (stepTagsOf(workflow)?.[step] ?? []).filter((t) => Object.hasOwn(tags, t)).map((t) => tags[t]).at(-1);
    // steps / tags に無い step は、targets.personas があれば persona で引かれているかもしれないので決めない（loadRuntimeRouting の説明）
    const d = routing.hasPersonas ? PM_UNKNOWN : routing.def;
    return s ? { provider: s.provider, model: s.model, source: routing.source }
             : { provider: d.provider, model: d.model, source: routing.source };
  };
  const subSeen = new Set();
  const actualPm = {}; // step → 切替後の実プロバイダー（レート上限などで変わったとき）
  // step#iter → 判定結果。label は judge フェーズの phase_complete.content（一致した rule のラベル。例: approved）、
  // stages は phase_judge_stage.response（structured_output の JSON。reason を含む）
  const judges = {};
  // step#iter → エラーの記録（phase_complete / step_complete の status が done 以外のときの error / content）。失敗行・error 行のクリックで表示する
  const errors = {};
  const noteError = (key, e, ts) => { const t = String(e.error ?? e.content ?? '').trim(); if (!t) return; (errors[key] ?? (errors[key] = [])).push({ ts, phase: e.phaseName ?? (e.type === 'step_complete' ? 'step' : e.type), status: e.status ?? '', text: t }); };
  // 並列の子は、親がレート上限で中断 → リトライすると同じ iteration のまま execute から走り直す（takt 0.73 で確認）。
  // 2 回目以降の execute 開始を別の試行として key に @n を付け、開始行とフェーズ行を 1 回目と分ける
  const attempts = {};
  const pendingSwitch = {}; // step → 開始行がまだ無い切替（並列の子）。開始行を作るときに載せる
  for (const e of events) {
    const t = e.type, ts = e.timestamp ?? '', st = e.step ?? '', it = e.iteration;
    const base = st + '#' + it;
    if (t === 'phase_start' && e.phaseName === 'execute' && st && !started.has(base) && subSeen.has(attempts[base] ? base + '@' + attempts[base] : base)) attempts[base] = (attempts[base] ?? 1) + 1;
    const key = attempts[base] ? base + '@' + attempts[base] : base;
    if (t === 'phase_judge_stage' && st) {
      const j = judges[key] ?? (judges[key] = { label: null, stages: [] });
      j.stages.push({ stage: e.stage ?? null, method: e.method ?? null, status: e.status ?? null, response: String(e.response ?? '') });
    }
    if (t === 'phase_complete' && e.phaseName === 'judge' && st) {
      const j = judges[key] ?? (judges[key] = { label: null, stages: [] });
      if (e.content) j.label = String(e.content).trim();
      j.ts = ts; // 判定した時刻（行の ts は step_complete の時刻で、judge より前のことがある）。最終判定を選ぶのに使う
    }
    // 切替の検知: レート上限等で provider が変わると、再開時の指示文に切替前/現在が書かれる
    if (t === 'phase_start' && ts && st) {
      const ui = String(e.userInstruction ?? '');
      // 通知文は takt 0.74.0 の fallback-notice テンプレート（日本語: 「- 切替前 provider/model: p / m」「- 現在の provider/model: p / m」、
      // 英語（takt の既定言語）: 「- Previous provider/model: …」「- Current provider/model: …」）。model が無いと takt は空文字を入れるので、
      // model は空でもよく、値は同じ行の中だけから取る（[ \t] で改行をまたがない。次の行の「-」や本文を model として拾わないため）
      const prev = ui.match(/(?:切替前|Previous) provider\/model:[ \t]*([\w.-]+)[ \t]*\/[ \t]*([\w.-]*)/);
      const cur = ui.match(/(?:現在の|Current) provider\/model:[ \t]*([\w.-]+)[ \t]*\/[ \t]*([\w.-]*)/);
      if (prev && cur) {
        const from = prev[1] + (prev[2] ? '/' + prev[2] : ''), to = cur[1] + (cur[2] ? '/' + cur[2] : '');
        const provider = cur[1], model = cur[2] || null;
        actualPm[st] = { provider, model, source: 'log' };
        // 切替はリトライの開始と同じ瞬間なので、別の行にせず開始行の provider 欄に「切替前 → 切替後」として載せる。
        // 通常ステップは step_start が先に来ているので直前の開始行に付け、並列の子は開始行がこの後に作られるので pending に置く
        const startRow = rows.findLast((r) => (r.kind === 'step' || r.kind === 'sub') && r.step === st && Math.abs(new Date(ts) - new Date(r.ts)) <= 5000);
        if (startRow) { startRow.switchFrom = from; startRow.provider = provider; startRow.model = model; startRow.source = 'log'; }
        else pendingSwitch[st] = { from, to, ts, top: started.has(base) };
      }
    }
    if (st && ts && e.phaseName === 'report') {
      const arr = reportPhases[key] ?? (reportPhases[key] = []);
      if (t === 'phase_start') arr.push({ start: ts, end: null });
      if (t === 'phase_complete') { const last = arr.find((x) => x.end === null) ?? arr[arr.length - 1]; if (last) last.end = ts; }
    }
    if (st && ts && (t === 'step_start' || t.startsWith('phase_') || t === 'step_complete')) {
      const w = windows[key] ?? (windows[key] = { start: ts, end: ts });
      if (ts < w.start) w.start = ts;
      if (ts > w.end) w.end = ts;
    }
    if (t === 'step_start') {
      started.add(key);
      rows.push({ ts, kind: 'step', key, step: st, workflow: e.workflow, iteration: it, provider: e.provider, model: e.model ?? null, source: 'log', reports: [] });
    } else if (t === 'phase_start' && e.phaseName === 'execute' && !started.has(key) && !subSeen.has(key)) {
      subSeen.add(key);
      const subRow = { ts, kind: 'sub', key, step: st, workflow: e.workflow, iteration: it, ...(actualPm[st] ?? cfgPm(st, e.workflow || meta.workflow)), reports: [] };
      if (pendingSwitch[st]) { subRow.switchFrom = pendingSwitch[st].from; delete pendingSwitch[st]; }
      rows.push(subRow);
    } else if (t === 'phase_complete') {
      if (st && e.status && e.status !== 'done') noteError(key, e, ts);
      // 並列の子は execute / report / judge の 3 フェーズとも終了を行にする（公式 UI の ITER LOG と同じ粒度）
      if (!started.has(key)) rows.push({ ts, kind: 'phase', key, step: st, phase: e.phaseName, status: e.status, error: e.status === 'error' ? String(e.error ?? e.content ?? '') : null });
      if (e.phaseName === 'execute' && e.content) lastOutput = { ts, step: st, content: String(e.content) };
    } else if (t === 'step_complete') {
      const lim = e.status === 'rate_limited' ? (String(e.content ?? '').match(/rateLimitInfo:\s*provider=([\w-]+)/)?.[1] ?? null) : null;
      if (e.status && e.status !== 'done') noteError(key, e, ts);
      rows.push({ ts, kind: 'done', key, step: st, status: e.status, rateProvider: lim });
    } else if (['step_rate_limited', 'workflow_abort', 'workflow_error', 'step_error'].includes(t)) {
      if (ts) rows.push({ ts, kind: 'alert', step: st, type: t, reason: e.reason ?? '', error: String(e.error ?? '') });
    }
  }
  for (const [st, p] of Object.entries(pendingSwitch)) rows.push({ ts: p.ts, kind: 'switch', step: st, top: p.top, from: p.from, to: p.to }); // 開始行に載せられなかった切替だけ行にする
  // 並列の子の実際の provider / model。takt の設定 logging.usage_events が有効なら、子の実行 1 回ごと（終わった時点）に
  // step・provider・provider_model が logs/<session>-usage-events.jsonl に書かれる（takt 0.74.0 の dist/core/logging/usageEventLogger.js と
  // dist/core/workflow/engine/agent-usage-event.js で確認）。設定から引いた値より正確なので、あれば上書きする。
  // 記録に iteration は無いので、同じ step の子の開始行に、開始より後の記録を古い順に 1 つずつ当てる（リトライの @n も試行ごとに記録がある）
  {
    const usage = readUsageEvents(runDir), used = new Set();
    for (const r of rows.filter((x) => x.kind === 'sub').sort((a, b) => a.ts.localeCompare(b.ts))) {
      const i = usage.findIndex((u, j) => !used.has(j) && u.step === r.step && u.at >= Date.parse(r.ts));
      if (i < 0) continue;
      used.add(i);
      r.provider = usage[i].provider; r.model = usage[i].model; r.source = 'log';
    }
  }
  rows.sort((a, b) => a.ts.localeCompare(b.ts) || ((a.kind === 'sub' && b.kind === 'sub') ? a.step.localeCompare(b.step) : 0));
  // 並列の子（sub）は、そのフェーズ行を子の直下にまとめて木にする（子の中は時刻順。子どうしは開始順 → 名前順）。
  // 枝は ├ 、judge まで終わった子だけ最後を └ にする（終わっていない子は次の行が来るかもしれないので ├ のまま）
  {
    const phasesByKey = {};
    for (const r of rows) if (r.kind === 'phase' && r.key) (phasesByKey[r.key] ?? (phasesByKey[r.key] = [])).push(r);
    const grouped = [], consumed = new Set();
    for (const r of rows) {
      if (r.kind === 'phase' && consumed.has(r)) continue;
      grouped.push(r);
      if (r.kind !== 'sub') continue;
      const ph = phasesByKey[r.key] ?? [];
      const finished = ph.some((p) => p.phase === 'judge');
      ph.forEach((p, i) => { p.tree = (finished && i === ph.length - 1) ? '└' : '├'; consumed.add(p); grouped.push(p); });
    }
    rows.length = 0; rows.push(...grouped);
  }
  // 判定結果を行に紐づけ（step_complete の timestamp は judge より前に書かれることがあるので、ループ後に付ける）
  // 付けるのは status が done の行だけ。レート上限で中断した step_complete とリトライ後の step_complete は同じ iteration を
  // 共有するので、絞らないと中断の行にリトライの判定が付く
  for (const r of rows) {
    if (r.status === 'done' && (r.kind === 'done' || (r.kind === 'phase' && r.phase === 'judge'))) r.judge = judges[r.key] ?? null;
    if (r.status && r.status !== 'done' && (r.kind === 'done' || r.kind === 'phase') && errors[r.key]) r.errors = errors[r.key];
  }
  // レポートを所属 step に紐づけ（mtime が step の時間帯 ±5秒に入るもの。複数候補なら最も遅く始まった step）
  const unmatched = [];
  const ms = (iso) => new Date(iso).getTime();
  for (const r of reports(runDir)) {
    const mt = r.mtime;
    let best = null, bestDist = Infinity;
    // 1) report フェーズの終了時刻に最も近い step（ファイルは report フェーズ末尾で書かれる）
    for (const [key, phases] of Object.entries(reportPhases)) {
      for (const ph of phases) {
        const end = ph.end ? ms(ph.end) : Date.now();
        if (mt >= ms(ph.start) - 2000 && mt <= end + 5000) {
          const d = Math.abs(end - mt);
          if (d < bestDist) { best = key; bestDist = d; }
        }
      }
    }
    // 2) 見つからなければ step 全体の時間帯で最も近い終了時刻のもの
    if (!best) {
      for (const [key, w] of Object.entries(windows)) {
        if (mt >= ms(w.start) - 5000 && mt <= ms(w.end) + 5000) {
          const d = Math.abs(ms(w.end) - mt);
          if (d < bestDist) { best = key; bestDist = d; }
        }
      }
    }
    let row = best && rows.find((x) => x.key === best && (x.kind === 'step' || x.kind === 'sub'));
    // 3) 時刻で引けないとき（run フォルダをコピー・zip 展開して mtime が変わった場合）は、ファイル名の stem がステップ名と同じ最後の行に付ける
    if (!row) { const stem = path.basename(r.rel, '.md'); row = [...rows].reverse().find((x) => (x.kind === 'step' || x.kind === 'sub') && x.step === stem); }
    if (row) row.reports.push(r.rel); else unmatched.push(r);
  }
  // 中断・失敗した run は、終わった時刻を最後の行にする。失敗は meta.endTime と meta.reason / meta.failure（例: rule_no_match）、
  // 中断（プロセスが落ちて status が running のまま）は meta.updatedAt（最後に書かれた時刻）を使う
  if (meta.status === 'interrupted') {
    // meta.currentStep は親ワークフローから見たステップ名（maintenance なら常に develop）で、どこで止まったか分からない。
    // タイムラインで「開始したが終わっていない」行（通常ステップは done 行が無いもの、並列の子は judge が終わっていないもの）を拾って並べる
    const judged = new Set(rows.filter((r) => r.kind === 'phase' && r.phase === 'judge').map((r) => r.key));
    // リトライは同じ key で開始行が 2 つあるので、「その開始行より後に同じ key の done 行が無い」ことで実行中と判定する
    const steps = rows.filter((r, i) => r.kind === 'step' && !rows.slice(i + 1).some((x) => x.kind === 'done' && x.key === r.key)).map((r) => r.step);
    const subs = rows.filter((r) => r.kind === 'sub' && !judged.has(r.key)).map((r) => r.step);
    const uniq = (a) => a.filter((v, i) => a.indexOf(v) === i);
    const label = steps.length ? uniq(steps).join('・') + (subs.length ? '（並列の子 ' + uniq(subs).length + ' 件）' : '') : uniq(subs).join('・');
    rows.push({ ts: meta.updatedAt, kind: 'end', status: 'interrupted', step: label ? label + ' の実行中' : (meta.currentStep ?? '') });
  }
  else if (meta.status === 'failed' || meta.status === 'aborted') {
    const step = meta.failure?.step ?? meta.currentStep ?? '';
    // 失敗したステップの「最後の試行」の判定（rule_no_match なら 3 段階のエラー内容）を付けて、クリックで原因を見られるようにする。
    // 同じステップの前の iteration の判定を付けないよう、その step の最後の開始行の key に限る
    const lastStart = [...rows].reverse().find((r) => (r.kind === 'step' || r.kind === 'sub') && r.step === step);
    const key = lastStart && judges[lastStart.key] ? lastStart.key : null;
    // エラーのリンクは「起きた行」（■ step → error や子の error 行）にだけ出す。失敗行は理由の文字と、判定があれば判定ログだけ
    // 理由が『Step "<step>" failed: …』の形なら、ステップ名は行頭に出しているので重複する前置きを落とす
    const reason = String(meta.reason ?? meta.failure?.error ?? '').replace(new RegExp('^Step "' + step.replace(/[.*+?^${}()|[\]\\]/g, '\\$&') + '" failed:\\s*'), '');
    rows.push({ ts: meta.endTime ?? meta.updatedAt, kind: 'end', status: meta.status, step, key: key ?? '', reason, judge: key ? judges[key] : null });
  }
  return { rows, lastOutput, unmatched, judges };
}

// ---------- レポート ----------
function walkMd(dir, base) {
  const out = [];
  for (const name of (existsSync(dir) ? readdirSync(dir) : [])) {
    const p = path.join(dir, name);
    const s = statSync(p);
    if (s.isDirectory()) out.push(...walkMd(p, base));
    else if (name.endsWith('.md')) out.push({ rel: path.relative(base, p), size: s.size, mtime: s.mtimeMs });
  }
  return out;
}
function reports(runDir) {
  const base = path.join(runDir, 'reports');
  return walkMd(base, base).sort((a, b) => a.mtime - b.mtime);
}

// ---------- workflow yaml（project → ~/.takt → builtins の順。max_steps と step の tags） ----------
function taktPackageDir() {
  for (const dir of (process.env.PATH ?? '').split(path.delimiter)) {
    const bin = path.join(dir, 'takt');
    if (!existsSync(bin)) continue;
    try { return path.dirname(path.dirname(realpathSync(bin))); } catch {}
  }
  return null;
}
// ワークフロー名から、存在して読める workflow yaml の本文を探す順に並べて返す（max_steps と step の tags で同じ探索を使う）
function workflowYamls(workflow, root) {
  if (!workflow) return [];
  const pkg = taktPackageDir();
  const candidates = [
    path.join(root, '.takt', 'workflows', workflow + '.yaml'),
    path.join(HOME, '.takt', 'workflows', workflow + '.yaml'),
    ...(pkg ? ['ja', 'en'].map((l) => path.join(pkg, 'builtins', l, 'workflows', workflow + '.yaml')) : []),
  ];
  const texts = [];
  for (const p of candidates) {
    if (!existsSync(p)) continue;
    try { texts.push(readFileSync(p, 'utf8')); } catch {}
  }
  return texts;
}
// max_steps が無いファイルは飛ばして次の候補を見る
function maxStepsFor(workflow, root) {
  for (const text of workflowYamls(workflow, root)) {
    const m = text.match(/^max_steps:\s*(\d+)/m);
    if (m) return Number(m[1]);
  }
  return null;
}
// workflow yaml のトップレベルの steps: の下にある step（並列の子を含む）の tags: を { step 名: [tag, …] } で返す。
// step は steps: 配下の配列要素（- で始まる塊）。YAML のキー順に意味は無く name: が最初とは限らないので、
// 要素の直下に並ぶキー（先頭行で - の後に書かれたキーと同じ字下げ。- の後の空白は 1 つとは限らない）から name: と tags: を取る。
// もっと深い字下げにある並列の子の name: / tags: は親のものとして拾わない。
// tags: の書き方はブロック形式（tags: の次の行から - review）とフロー形式（tags: [review]。閉じ括弧まで複数行に分かれることもある）がある
function stepTagsIn(text) {
  const out = {};
  const lines = text.split('\n').map((l) => stripYamlComment(l).trimEnd());
  const start = lines.findIndex((l) => /^steps:/.test(l));
  if (start < 0) return out;
  let end = lines.findIndex((l, i) => i > start && /^\S/.test(l));
  if (end < 0) end = lines.length;
  const indentOf = (l) => l.match(/^\s*/)[0].length;
  const unquote = (v) => v.trim().replace(/^['"]|['"]$/g, '');
  for (let i = start + 1; i < end; i++) {
    const m = lines[i].match(/^(\s*)-(\s+)\S/);
    if (!m) continue;
    const d = m[1].length; // - の位置
    const kd = d + 1 + m[2].length; // 要素のキーの位置（- の後の空白の数ぶんずれる）
    // 要素の本文。先頭行は「-」を空白に置き換えて、2 行目以降のキーと同じ字下げ（kd）で扱う
    const body = [lines[i].replace(/^(\s*)-/, '$1 ')];
    let j = i + 1;
    for (; j < end && (!lines[j].trim() || indentOf(lines[j]) > d); j++) body.push(lines[j]);
    let name = null; const tags = [];
    for (let k = 0; k < body.length; k++) {
      if (!body[k].trim() || indentOf(body[k]) !== kd) continue;
      let x;
      if ((x = body[k].match(/^\s*name:\s*(.+)$/))) name = unquote(x[1]);
      else if ((x = body[k].match(/^\s*tags:\s*(.*)$/))) {
        let v = x[1].trim();
        if (v) {
          // フロー形式。閉じ括弧が同じ行に無ければ、閉じ括弧の行まで続きをつなぐ
          for (let q = k + 1; v.startsWith('[') && !v.includes(']') && q < body.length; q++) v += ' ' + body[q].trim();
          tags.push(...v.replace(/^\[|\]$/g, '').split(',').map(unquote).filter(Boolean));
        } else {
          for (let q = k + 1; q < body.length; q++) {
            if (!body[q].trim()) continue;
            const y = body[q].match(/^(\s*)-\s*(.+)$/);
            if (!y || y[1].length < kd) break; // tags: の項目でない行（次のキーなど）が来たら終わり
            tags.push(unquote(y[2]));
          }
        }
      }
    }
    if (name && /^[\w.-]+$/.test(name) && !Object.hasOwn(out, name)) out[name] = tags; // 同じ名前の step が複数あれば最初のもの
    // 本文は読み飛ばさない。並列の子（parallel: の下の - name:）も本文の中にある要素なので、次の周で同じように見る
  }
  return out;
}

// ---------- tasks.yaml（worktree → 本体リポジトリを clone-meta と tasks.yaml の worktree_path で逆引き） ----------
function tasksYamlFor(root) {
  const direct = path.join(root, '.takt', 'tasks.yaml');
  if (existsSync(direct)) return { path: direct, text: readFileSync(direct, 'utf8') };
  for (const repo of repoCandidates()) {
    if (!worktreePathsOf(repo).includes(root)) continue;
    const p = path.join(repo, '.takt', 'tasks.yaml');
    if (existsSync(p)) try { return { path: p, text: readFileSync(p, 'utf8') }; } catch {}
  }
  return { path: null, text: '' };
}

// tasks.yaml を軽くパースして一覧用の配列にする（yaml ライブラリ非依存。トップレベルの "  - " 区切り）
function parseTasks(text) {
  if (!text) return [];
  const items = text.split(/\n(?=  - )/).filter((b) => /^  - /.test(b));
  // 各タスクの最初のキーは「  - 」の行に書かれる（takt 0.74.0 は yaml の stringify で書き、先頭はそのタスクにある最初のキー。
  // 実行設定が無ければ name、worktree が無ければ branch や issue になる）。2 つ目以降の 4 スペース字下げの行と同じ扱いで読む。
  // 値の前の空白は改行を含めない（\s* だと値が空のキーが次の行のキーと値を拾う。空なら下の継続行の処理に回す）
  const field = (block, key) => {
    const m = block.match(new RegExp('^(?:\\s{4}|  - )' + key + ':[ \\t]*(.*)$', 'm'));
    if (!m) return '';
    let v = m[1].trim();
    if (/^".*"$/.test(v)) { try { v = JSON.parse(v); } catch { v = v.slice(1, -1); } }
    else if (/^'.*'$/.test(v)) v = v.slice(1, -1).replace(/''/g, "'");
    else if (/^["']/.test(v)) {
      // 複数行に折り返された引用文字列: 閉じ引用符の行まで継続行（6 スペース字下げ）をつなぐ（YAML では改行は空白 1 つになる）
      const q = v[0];
      const idx = block.indexOf(m[0]) + m[0].length;
      const parts = [v];
      for (const l of block.slice(idx).split('\n').slice(1)) {
        if (!/^\s{6}/.test(l)) break;
        parts.push(l.trim());
        if (l.trimEnd().endsWith(q)) break;
      }
      const joined = parts.join(' ');
      if (q === '"') { try { v = JSON.parse(joined); } catch { v = joined.replace(/^"|"$/g, ''); } }
      else v = joined.replace(/^'|'$/g, '').replace(/''/g, "'");
    }
    else if (v === '' || v === '|' || v === '|-' || v === '>' || v === '>-') {
      const idx = block.indexOf(m[0]) + m[0].length;
      const rest = block.slice(idx).split('\n').slice(1);
      const lines = [];
      for (const l of rest) { if (/^\s{6}/.test(l) || l.trim() === '') lines.push(l.replace(/^\s{6}/, '')); else break; }
      v = lines.join(' ').trim();
    }
    return v;
  };
  // status は tasks.yaml の値のまま返す（中断の読み替えは taskStatus でする）。owner_pid は taskStatus 用で、/api/state の currentTask には出さない
  return items.map((b) => ({
    raw: b, worktree_path: field(b, 'worktree_path'), branch: field(b, 'branch'), run_slug: field(b, 'run_slug'),
    name: field(b, 'name'), status: field(b, 'status'), workflow: field(b, 'workflow'), issue: field(b, 'issue'),
    summary: field(b, 'summary').replace(/^#+\s*/, '').split('\n')[0],
    created_at: field(b, 'created_at'), completed_at: field(b, 'completed_at'), owner_pid: field(b, 'owner_pid'),
  }));
}

// ---------- state ----------
// runs は findRuns() の結果（1 回の要求で 1 回だけ走査する）。taskCache は tasks.yaml のパース結果のキャッシュ（同じ要求の中で共有する）
function currentRun(sel, runs, taskCache) {
  if (sel) {
    const hit = runs.find((r) => r.runDir === sel);
    if (hit) return hit;
    // 一覧に無いネットワーク上のパス（\\host\share・//host/share）は開かない。?run= は外部サイトのリンクや埋め込みからも届くので、
    // それだけで Windows が SMB に接続（資格情報を送る）しないよう、meta.json を読む前に見つからない扱いにする。
    // ただし <run_dir> の run は除く。利用者がコマンドラインで指定した場所で、起動時と ?run= なしの要求で既に読んでいる。
    // <run_dir> は一覧に入らないことがあり、UI は 2 回目の取得から表示中の run の runDir を ?run= で送り返すので、ここで弾くとネットワーク上の <run_dir> が開けなくなる
    if (isNetworkPath(sel) && sel !== FIXED_RUN_DIR) return null;
    try { return runRecord(sel, taskCache); } catch {} // 一覧に無くても meta.json があれば開く
    return null; // 指定した run が無いときに別の run を返すと、URL と表示が食い違う。見つからなかったことは state() の runNotFound で返す
  }
  if (FIXED_RUN) return runRecord(FIXED_RUN, taskCache);
  return runs[0] ?? null;
}
function taskForRoot(root, cache) {
  if (!cache.has(root)) cache.set(root, parseTasks(tasksYamlFor(root).text));
  return cache.get(root).find((t) => t.worktree_path && t.worktree_path === root) || null;
}
// 一覧は新しい 20 件。表示中の run がそれより古いときは先頭に足す（ドロップダウンに無いと別の run が選ばれて見える）
function runList(active, limit, all, taskCache) {
  const top = all.slice(0, limit);
  if (active && !top.some((r) => r.runDir === active.runDir)) { const me = all.find((r) => r.runDir === active.runDir) ?? active; top.unshift(me); }
  const list = top.map((r) => {
    const t = taskForRoot(r.root, taskCache);
    return { runDir: r.runDir, status: r.meta.status, slug: r.meta.runSlug, step: r.meta.currentStep, updatedAt: r.meta.updatedAt, label: t ? (t.summary || t.name) : (r.label ?? null) };
  });
  list.total = all.length;
  return list;
}
function state(sel, showAll = false) {
  const limit = showAll ? Infinity : 20;
  const taskCache = new Map();
  const found = findRuns(taskCache);
  const active = currentRun(sel, found, taskCache);
  if (!active) { const runs = runList(null, limit, found, taskCache); return { active: null, runs, runsTotal: runs.total, ...(sel ? { runNotFound: sel } : {}) }; }
  const routing = routingFor(active.runDir, active.meta.startTime);
  const tl = timeline(active.runDir, routing, active.meta, (wf) => stepTagsFor(active.runDir, routing, wf, active.root));
  const tasks = tasksYamlFor(active.root);
  const runs = runList(active, limit, found, taskCache);
  const task = taskForRoot(active.root, taskCache);
  let currentTask = null;
  if (task) { const { owner_pid, ...rest } = task; currentTask = { ...rest, status: taskStatus(task) }; } // owner_pid は応答に出さない
  return {
    runs, runsTotal: runs.total,
    active: { meta: active.meta, runDir: active.runDir, root: active.root, reports: tl.unmatched, maxSteps: maxStepsFor(active.meta.workflow, active.root) },
    timeline: tl.rows,
    lastOutput: tl.lastOutput,
    tasksPath: tasks.path ? tildify(tasks.path) : null, // 表示用（画面で HOME を決め打ちせずに済むよう、サーバーの HOME で縮める）
    // リポジトリ名: tasks.yaml の置き場（<repo>/.takt/tasks.yaml）から取る。取れなければ run のルートのディレクトリ名
    repo: path.basename(tasks.path ? path.resolve(tasks.path, '..', '..') : active.root),
    currentTask, // worktree が一致するエントリだけ。無ければ「キューなし」
  };
}
function reportText(rel, sel) {
  const taskCache = new Map();
  const active = currentRun(sel, findRuns(taskCache), taskCache);
  if (!active) return null;
  const base = path.join(active.runDir, 'reports');
  const p = path.resolve(base, rel);
  if (!p.startsWith(base + path.sep) || !existsSync(p) || !statSync(p).isFile()) return null;
  return readFileSync(p, 'utf8');
}

// ---------- HTML ----------
// 画面は bin/ui/（index.html・app.css・app.js）。index.html の <link> と <script src> をファイルの中身に置き換えて 1 枚の HTML にして返す。
// 配信のルートは / だけで済み、npm link 中はブラウザのリロードで編集が反映される（リクエストごとに読む）
const UI_DIR = path.join(path.dirname(fileURLToPath(import.meta.url)), 'ui');
function pageHtml() {
  const read = (name) => readFileSync(path.join(UI_DIR, name), 'utf8');
  const inline = (html, tag, replacement) => {
    if (!html.includes(tag)) throw new Error('index.html に ' + tag + ' がありません');
    return html.replace(tag, () => replacement);
  };
  let html = read('index.html');
  html = inline(html, '<link rel="stylesheet" href="app.css">', '<style>\n' + read('app.css') + '</style>');
  html = inline(html, '<script src="app.js"></script>', '<script>\n' + read('app.js') + '</script>');
  return html;
}

// <run_dir> 固定のときは listen 前に meta.json を読めるか確かめる（読めないまま起動すると最初の /api/state で落ちるため）
if (FIXED_RUN) {
  try { runRecord(FIXED_RUN, new Map()); }
  catch (e) {
    // stderr がパイプだと console.error は非同期で、直後の process.exit で消えることがあるので同期で書く
    writeSync(2, 'takt-dashboard: ' + path.join(path.resolve(FIXED_RUN), 'meta.json') + ' を読めません: ' + e.message + '\n');
    process.exit(1);
  }
}

// DNS rebinding 対策: 外部サイトのドメインを 127.0.0.1 に向けられても、Host が許可リストに無ければ応答しない
// ポート付きの形は listen 後に実際のポートで足す（--port 0 で OS が選んだポートでも合うように）
const LOCAL_HOSTS = ['localhost', '127.0.0.1', '[::1]'];
const ALLOWED_HOSTS = new Set(LOCAL_HOSTS);

// requireHostHeader: false — 既定（true）だと Host の無い要求は Node がハンドラより前に 400 を返すので、ハンドラで 403 にする
createServer({ requireHostHeader: false }, (req, res) => {
  try {
    if (!ALLOWED_HOSTS.has((req.headers.host ?? '').toLowerCase())) {
      res.writeHead(403, { 'content-type': 'text/plain; charset=utf-8' });
      res.end('forbidden');
      return;
    }
    const url = new URL(req.url, 'http://localhost');
    if (url.pathname === '/api/state') {
      // 例外時に 500 を返せるよう、本文を作ってからヘッダーを書く
      const body = JSON.stringify(state(url.searchParams.get('run') || null, url.searchParams.get('all') === '1'));
      res.writeHead(200, { 'content-type': 'application/json' });
      res.end(body);
      return;
    }
    if (url.pathname === '/takt-logo.svg') {
      // ロゴは takt 本体に同梱の docs/assets/takt-logo-dark.svg（公式 Web UI が /takt-logo.svg として配信しているもの）を読む。
      // ~/.config/takt-dashboard/takt-logo.svg があればそちらを優先。どちらも無ければ 404 にして文字の見出しにフォールバック
      const pkg = taktPackageDir();
      const logo = [path.join(CFG_DIR, 'takt-logo.svg'), ...(pkg ? [path.join(pkg, 'docs', 'assets', 'takt-logo-dark.svg')] : [])].find((p) => existsSync(p));
      if (!logo) { res.writeHead(404); res.end(); return; }
      const svg = readFileSync(logo); // 例外時に 500 を返せるよう、本文を作ってからヘッダーを書く
      res.writeHead(200, { 'content-type': 'image/svg+xml', 'cache-control': 'max-age=86400' });
      res.end(svg);
      return;
    }
    if (url.pathname === '/api/report') {
      const t = reportText(url.searchParams.get('p') ?? '', url.searchParams.get('run') || null);
      res.writeHead(t === null ? 404 : 200, { 'content-type': 'text/plain; charset=utf-8' });
      res.end(t ?? 'not found');
      return;
    }
    const html = pageHtml(); // 例外時に 500 を返せるよう、本文を作ってからヘッダーを書く（bin/ui/ の読み込み失敗・index.html のタグ欠け）
    res.writeHead(200, { 'content-type': 'text/html; charset=utf-8', 'cache-control': 'no-store' }); // 再起動後に古いページが使われないように
    res.end(html);
  } catch (e) {
    // ハンドラ内の例外でプロセスを落とさない。ヘッダー送出後なら接続を切る
    console.error('takt-dashboard: ' + req.url + ' の処理に失敗: ' + (e?.stack ?? e));
    if (res.headersSent) { res.destroy(); return; }
    res.writeHead(500, { 'content-type': 'text/plain; charset=utf-8' });
    res.end('internal error');
  }
}).listen(PORT, '127.0.0.1', function () { // ローカル専用。他のマシンからは繋がらない
  const { port } = this.address(); // --port 0 なら OS が選んだポート
  for (const h of LOCAL_HOSTS) ALLOWED_HOSTS.add(h + ':' + port);
  console.log('takt-dashboard: http://localhost:' + port);
});
