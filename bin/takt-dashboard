<header><h1><a href="/" title="最新の run に戻る"><img src="/takt-logo.svg" alt="TAKT" class="logo" onerror="this.replaceWith('TAKT')"> ダッシュボード</a></h1><select id="runsel" onchange="selectRun(this.value)"></select><span class="muted" id="upd" style="margin-left:auto"></span></header>
